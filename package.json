{
  "workspaces": [
    "packages/@oveo/*",
    "packages/@oveo/optimizer/packages/*",
    "packages/oveo",
    "tests"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "bun test ./tests/",
    "check": "oxlint",
    "format": "oxfmt",
    "napi-build": "napi build --platform --esm --manifest-path ./packages/@oveo/optimizer/Cargo.toml --package-json-path ./packages/@oveo/optimizer/package.json --output-dir ./packages/@oveo/optimizer"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.9.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rolldown": "^1.2.8",
    "typescript": "^7.0.2"
  }
}
