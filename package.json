{
  "workspaces": [
    "packages/@oveo/*",
    "packages/@oveo/optimizer/packages/*",
    "packages/oveo",
    "tests"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "bun test ./tests/",
    "check": "oxlint",
    "format": "oxfmt",
    "napi-build": "napi build --platform --esm --manifest-path ./packages/@oveo/optimizer/Cargo.toml --package-json-path ./packages/@oveo/optimizer/package.json --output-dir ./packages/@oveo/optimizer"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.12",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "rolldown": "^1.3.1",
    "typescript": "^7.0.2"
  }
}
